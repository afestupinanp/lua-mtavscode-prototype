{
	"name": "lua-mtavscode",
	"displayName": "lua-mtavscode",
	"description": "A VSCode extension that enables suggestions and various other elements for the Multi Theft Auto San Andreas multiplayer mod to your current Lua LSP.",
	"version": "0.4.0",
	"engines": {
		"vscode": "^1.96.0"
	},
	"categories": [
		"Other",
		"Extension Packs",
		"Language Packs"
	],
	"activationEvents": [
		"workspaceContains:**/meta.xml",
		"workspaceContains:**/client.lua",
		"workspaceContains:**/server.lua"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "lua-mtavscode.scaffold-project",
				"title": "Lua MTAVScode: Scaffold a new resource"
			}
		],
		"configuration": {
			"title": "lua-mtavscode",
			"properties": {
				"lua-mtavscode.serverSideFileKeywords": {
					"type": "array",
					"default": [
						"s_",
						"server"
					],
					"description": "This configuration allows the extension to know which keyword in a file corresponds to a serversided Lua script."
				},
				"lua-mtavscode.clientSideFileKeywords": {
					"type": "array",
					"default": [
						"c_",
						"client"
					],
					"description": "This configuration allows the extension to know which keyword in a file corresponds to a clientsided Lua script."
				}
			}
		},
		"snippets": [
			{
				"language": "lua",
				"path": "./src/snippets/lua.json"
			},
			{
				"language": "xml",
				"path": "./src/snippets/xml.json"
			}
		]
	},
	"repository": "https://github.com/afestupinanp/lua-mtavscode-prototype",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc --diagnostics -p ./",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"test": "node ./out/test/runTest.js",
		"generate": "node scripts/generate.js",
		"package": "vsce package",
		"publish": "vsce publish"
	},
	"devDependencies": {
		"@types/glob": "^8.1.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.13.10",
		"@types/vscode": "^1.96.0",
		"@typescript-eslint/eslint-plugin": "^8.26.1",
		"@typescript-eslint/parser": "^8.26.1",
		"@vscode/vsce": "^3.2.2",
		"eslint": "^9.22.0",
		"glob": "^11.0.1",
		"jsdom": "^26.0.0",
		"mocha": "^11.1.0",
		"turndown": "^7.2.0",
		"typescript": "^5.8.2",
		"vscode-test": "^1.6.1"
	}
}
